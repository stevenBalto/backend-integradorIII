APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rooster_pizza
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VITE_APP_NAME="${APP_NAME}"

# ── Inicio de sesion con Google (OAuth 2.0, cliente "Aplicacion web") ────────
# Las credenciales son COMPARTIDAS por el equipo: pedile a Steven el ID y el
# secreto y pegalos aca. NO se suben al repo (este archivo es solo la plantilla).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origenes desde los que se permite volver despues del login. El front manda el
# suyo y el backend lo valida contra esta lista (sin esto seria un open redirect).
# 4200 = `ng serve` / `npm start`;  8100 = `ionic serve`.
# OJO: cada origen tambien tiene que estar cargado en Google Cloud Console como
# "URI de redireccionamiento autorizado", con /api/auth/google/callback al final.
GOOGLE_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100

# Respaldo: solo se usa si el front no manda origen o manda uno no permitido.
GOOGLE_FRONTEND_URL=http://localhost:4200
